{
  "name": "live-review",
  "version": "0.1.10",
  "description": "直播复盘工具 —— 多平台直播录制、弹幕归档与复盘检索",
  "main": "./out/main/index.js",
  "author": "self",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "clean": "rd /s /q out 2>nul & rd /s /q dist\\win-unpacked 2>nul & rd /s /q dist\\win-unpacked.tmp 2>nul & exit /b 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64 && npm run clean",
    "dist:fresh": "npm run clean && npm run dist",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.self.livereview",
    "productName": "LiveReview",
    "files": [
      "out/**/*",
      "node_modules/nodemailer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/funasr_runner.py",
        "to": "funasr_runner.py"
      },
      {
        "from": "resources/funasr_download_models.py",
        "to": "funasr_download_models.py"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LiveReview-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.6",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "nodemailer": "^6.10.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
